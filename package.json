{
  "name": "newtonite-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Newtonite Operations Management System",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "test": "npm --prefix backend test",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run build",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "setup": "npm --prefix backend run prisma:generate && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
