generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkItemStatus {
  Open
  InProgress
  AwaitingApproval
  Resolved
  Closed

  @@map("work_item_status")
}

enum WorkItemPriority {
  Low
  Medium
  High
  Critical

  @@map("work_item_priority")
}

enum WorkItemType {
  Task
  Incident
  Request
  Change

  @@map("work_item_type")
}

enum TeamRole {
  Viewer
  Member
  Lead
  Admin

  @@map("team_role")
}

enum OutboxStatus {
  Pending
  Processing
  Completed
  Failed

  @@map("outbox_status")
}

model User {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String           @unique @db.VarChar(255)
  passwordHash     String           @map("password_hash") @db.VarChar(255)
  displayName      String           @map("display_name") @db.VarChar(255)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships      Membership[]
  assignedWork     WorkItem[]       @relation("WorkItemAssignee")
  createdWork      WorkItem[]       @relation("WorkItemCreator")
  comments         Comment[]
  activityEvents   ActivityEvent[]
  idempotencyKeys  IdempotencyKey[]

  @@map("users")
}

model Team {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @unique @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships    Membership[]
  workItems      WorkItem[]
  comments       Comment[]
  activityEvents ActivityEvent[]
  outboxJobs     OutboxJob[]

  @@map("teams")
}

model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  role      TeamRole @default(Member)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId], map: "idx_memberships_user")
  @@index([teamId], map: "idx_memberships_team")
  @@map("memberships")
}

model WorkItem {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId       String            @map("team_id") @db.Uuid
  title        String            @db.VarChar(500)
  description  String?           @default("")
  type         WorkItemType      @default(Task)
  priority     WorkItemPriority  @default(Medium)
  status       WorkItemStatus    @default(Open)
  assigneeId   String?           @map("assignee_id") @db.Uuid
  createdBy    String            @map("created_by") @db.Uuid
  dueAt        DateTime?         @map("due_at") @db.Timestamptz(6)
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  searchVector Unsupported("tsvector")? @map("search_vector")
  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee     User?             @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User              @relation("WorkItemCreator", fields: [createdBy], references: [id])
  comments     Comment[]
  activityEvents ActivityEvent[]

  @@index([teamId, status, createdAt(sort: Desc), id(sort: Desc)], map: "idx_work_items_team_status_created")
  @@index([teamId, assigneeId, status], map: "idx_work_items_team_assignee_status")
  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_work_items_team_created")
  @@map("work_items")
}

model Comment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workItemId String   @map("work_item_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id])

  @@index([workItemId, createdAt(sort: Desc)], map: "idx_comments_work_item")
  @@map("comments")
}

model ActivityEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workItemId String   @map("work_item_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(50)
  payload    Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([workItemId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_activity_events_work_item")
  @@index([teamId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_activity_events_team_created")
  @@map("activity_events")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @default("{}") @map("response_body") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id])

  @@unique([userId, key])
  @@map("idempotency_keys")
}

model OutboxJob {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String       @map("team_id") @db.Uuid
  aggregateId String       @map("aggregate_id") @db.Uuid
  eventType   String       @map("event_type") @db.VarChar(50)
  payload     Json         @default("{}") @db.JsonB
  status      OutboxStatus @default(Pending)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime?    @map("locked_at") @db.Timestamptz(6)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("outbox_jobs")
}
