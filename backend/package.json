{
  "name": "newtonite-ops-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run prisma:migrate",
    "db:migrate:legacy": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "prisma:generate": "cd .. && ./backend/node_modules/.bin/prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "cd .. && ./backend/node_modules/.bin/prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "prisma:status": "cd .. && ./backend/node_modules/.bin/prisma migrate status --schema=backend/prisma/schema.prisma",
    "prisma:studio": "cd .. && ./backend/node_modules/.bin/prisma studio --schema=backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "prisma": "^6.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
